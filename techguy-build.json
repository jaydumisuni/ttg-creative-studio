{
  "schemaVersion": 1,
  "appName": "TTG Creative Studio",
  "appVersion": "0.1.0-alpha",
  "publisher": "THETECHGUY DIGITAL SOLUTIONS",
  "domain": "thetechguyds.com",
  "repository": "jaydumisuni/ttg-creative-studio",
  "githubRelease": {
    "repository": "jaydumisuni/ttg-creative-studio"
  },
  "output": {
    "dist": "dist",
    "installer": "installer"
  },
  "signing": {
    "release_signing_required": true
  },
  "installer": {
    "requireCustomGraphicalInstaller": true,
    "requireRegisteredUninstall": true,
