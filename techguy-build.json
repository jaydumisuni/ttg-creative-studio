    "runAsAdmin": false
  },
  "appLifecycle": {
    "appId": "ttg-creative-studio",
    "stage": "testing",
    "public": false
  },
  "capabilities": {
    "platforms": [
      "windows",
      "linux"
    ],
    "storefront": {
      "enabled": false,
      "downloadsMetric": false,
      "helpfulMetric": false,
      "feedback": false,
      "screenshots": false,
      "changelog": false
    },
    "distribution": {
      "providers": [
        "github"
      ]
    },
    "browserIntegration": {
      "enabled": false
    }
  },
  "maintenance": {
    "tool_id": "ttg-creative-studio",
    "enabled": false,
    "check_on_launch": false,
    "auto_apply": false
  },
  "releaseControl": {
    "enabled": false,
    "onlineRequired": false,
    "loginRequired": false,
    "subscriptionRequired": false,
    "licenseRequired": false,
    "updateCheckOnLaunch": false,
    "offlineTimeoutMinutes": 60
